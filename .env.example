# Mozarex Platform & AivekAI Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# 1. Application Configuration
NODE_ENV=production
PORT=3000
SESSION_SECRET=your_session_signing_secret_here

# 2. Supabase Database Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. AivekAI Nutrition & AI Backend Configuration
OPENAI_API_KEY=your_openai_api_key_here
AIVEKAI_SESSION_SIGNING_SECRET=your_aivekai_session_signing_secret_here

# 4. PayPal Environment Selection
PAYPAL_ENVIRONMENT=sandbox

# 5. PayPal Sandbox Credentials (Used exclusively when PAYPAL_ENVIRONMENT=sandbox)
PAYPAL_SANDBOX_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_SANDBOX_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_SANDBOX_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# 6. PayPal Live Credentials (Used exclusively when PAYPAL_ENVIRONMENT=live)
PAYPAL_LIVE_CLIENT_ID=your_paypal_live_client_id_here
PAYPAL_LIVE_CLIENT_SECRET=your_paypal_live_client_secret_here
PAYPAL_LIVE_WEBHOOK_ID=your_paypal_live_webhook_id_here

# 7. PayPal Production Live Safety Gates (Phase 7B / 7B.1)
PAYPAL_LIVE_PAYOUTS_ENABLED=false
PAYPAL_LIVE_FIRST_PAYOUT_MAX_MINOR=1000
